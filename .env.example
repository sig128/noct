# NOCT server configuration. Names only: fill values in .env.local (never commit it).
# Every variable is optional; unset values fall back to safe defaults or turn the
# dependent feature off with a visible explanation in Settings.

# Jupiter APIs (swap, tokens, prices, lend). Default host: https://api.jup.ag
JUPITER_API_BASE=
# Optional key for higher rate limits; sent server-side only as x-api-key.
JUPITER_API_KEY=

# NOCT runs on Solana mainnet only.
# Dedicated mainnet RPC endpoint. Without it NOCT uses Helius (if HELIUS_API_KEY
# is set) or the public RPC, which is rate limited.
SOLANA_RPC_URL_MAINNET=

# Helius key for the Privacy Rings indexer and prover (and Helius RPC).
# Without it, private balances are unavailable.
HELIUS_API_KEY=

# Privacy Rings service endpoints. Defaults are the mainnet deployment in the
# @heliuslabs/spr 0.9.0-alpha README; RPC, indexer and prover must match the release.
SPR_INDEXER_URL_MAINNET=
SPR_PROVER_URL_MAINNET=
SPR_POLICY_BASE=

# Private balances stay off unless this is exactly "true".
# Enable only after reviewing the current audit and launch status.
SPR_MAINNET_ENABLED=

# Optional. Without it, the independent price check on borrowing reads Pyth's
# on-chain feed accounts through the RPC. With it, prices come from Hermes.
PYTH_API_KEY=
# Hermes-compatible base URL. Default: https://pyth.dourolabs.app/hermes
PYTH_HERMES_BASE=

# Comma-separated extra origins allowed to call write endpoints (default: same origin only).
NOCT_ALLOWED_ORIGINS=
# Token icons come through the wsrv.nl image service. If it is down, the proxy
# fetches directly from built-in hosts plus these (comma-separated).
NOCT_ICON_HOSTS=

# 1 silences operational logs (logs never contain amounts, addresses or keys).
NOCT_SILENT_LOGS=
# Alternative build output directory (default .next).
NOCT_DIST_DIR=
